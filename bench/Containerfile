# Headless runtime for Meld's benchmark harness: GTK4 stack + Xvfb.
# Build: docker build -t meld-bench -f bench/Containerfile bench
FROM ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-gi python3-gi-cairo python3-cairo python3-pytest \
        gir1.2-gtk-4.0 gir1.2-gtksource-5 gir1.2-adw-1 \
        libglib2.0-bin libglib2.0-dev-bin xvfb xauth dbus-x11 git rsync diffutils \
        adwaita-icon-theme fonts-dejavu-core python3-pip ca-certificates \
    && pip3 install --break-system-packages py-spy \
    && rm -rf /var/lib/apt/lists/*
